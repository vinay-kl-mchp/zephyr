# Disable unwanted libraries
CONFIG_SPIN_VALIDATE=n

# Enables support for GPIO drivers on the target platform.
CONFIG_GPIO=y

# For XC-DSC toolchain the default check init script of zephyr will fail
# because of an extra prepended underscore on symbols generated,
# For this reason keeping it disabled
CONFIG_CHECK_INIT_PRIORITIES=n

CONFIG_HW_STACK_PROTECTION=y
