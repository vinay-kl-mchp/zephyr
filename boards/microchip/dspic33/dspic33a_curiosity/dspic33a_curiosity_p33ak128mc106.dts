/dts-v1/;
#include <dspic/dspic33ak_mc/p33ak128mc106.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "Microchip dsPIC33A Curiosity Platform Development Board";
	compatible = "microchip,dspic33a-curiosity-p33ak128mc106";

	chosen {
		zephyr,flash = &flash0;
		zephyr,sram = &sram0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led-0 {
			gpios = <&gpioc 3 GPIO_ACTIVE_LOW>;
			label = "P28 LED0";
		};

		led1: led-1 {
			gpios = <&gpioc 4 GPIO_ACTIVE_LOW>;
			label = "P30 LED1";
		};

		led2: led-2 {
			gpios = <&gpioc 5 GPIO_ACTIVE_LOW>;
			label = "P32 LED2";
		};

		led3: led-3 {
			gpios = <&gpioc 6 GPIO_ACTIVE_LOW>;
			label = "P34 LED3";
		};

		led4: led-4 {
			gpios = <&gpioc 7 GPIO_ACTIVE_LOW>;
			label = "P36 LED4";
		};

		led5: led-5 {
			gpios = <&gpioc 8 GPIO_ACTIVE_LOW>;
			label = "P50 LED5";
		};

		led6: led-6 {
			gpios = <&gpioc 9 GPIO_ACTIVE_LOW>;
			label = "P52 LED6";
		};

		led7: led-7 {
			gpios = <&gpioc 10 GPIO_ACTIVE_LOW>;
			label = "P54 LED7";
		};
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		led3 = &led3;
		led4 = &led4;
		led5 = &led5;
		led6 = &led6;
		led7 = &led7;
	};
};

&cpu0 {
	clock-frequency = <8000000>;
	status = "okay";
	cpu-power-states = <&idle>;
};

&timer1 {
	status = "okay";
};
