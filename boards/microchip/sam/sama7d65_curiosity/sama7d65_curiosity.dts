/dts-v1/;
#include <common/freq.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/mfd/mfd_mchp_sam_flexcom.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <dt-bindings/sam/sama7d6/sama7d65/sama7d65-pinctrl.h>
#include <microchip/sam/sama7/sama7d6/sama7d65.dtsi>

/ {
	model = "SAMA7D65-Curiosity board";
	compatible = "microchip,sama7d65curiosity", "microchip,sama7d6", "microchip,sama7";

	aliases {
		adc0 = &adc;
		eeprom-0 = &eeprom0;
		led0 = &led_blue;
		pwm-0 = &pwm;
		pwm-led0 = &green_pwm_led;
		pwm-test = &pwm;
		sdhc0 = &sdmmc1;
		sw0 = &button_user;
	};

	chosen {
		zephyr,sram = &ddram;
		zephyr,canbus = &mcan1;
		zephyr,console = &uart6;
		zephyr,shell-uart = &uart6;
		zephyr,system-timer = &pit64b0;
	};

	clocks {
		main_xtal {
			clock-frequency = <DT_FREQ_M(24)>;
		};

		slow_xtal {
			clock-frequency = <32768>;
		};
	};

	ddram: ddram@60000000 {
		compatible = "ddram";
		reg = <0x60000000 DT_SIZE_M(1024)>;
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		led_red: red {
			label = "red";
			gpios = <&piob 17 GPIO_ACTIVE_HIGH>;
		};

		led_green: green {
			label = "green";
			gpios = <&piob 15 GPIO_ACTIVE_HIGH>;
		};

		led_blue: blue {
			label = "blue";
			gpios = <&pioa 21 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		status = "okay";

		button_user: button_sw2 {
			label = "PB_USER";
			gpios = <&pioc 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";

		red_pwm_led: red_pwm_led {
			pwms = <&pwm 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};

		green_pwm_led: green_pwm_led {
			pwms = <&pwm 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};

		blue_pwm_led: blue_pwm_led {
			pwms = <&pwm 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
	};
};

&adc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_mikrobus_an_default>;
	status = "okay";
};

&aes {
	status = "okay";
};

&ebi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_nand_default>;
	status = "okay";

	cs0: cs@40000000 {
		reg = <0x0 0x0 0x800000>;
		smc-tdf-mode;
		smc-write-mode = "nwe";
		smc-read-mode = "nrd";
		smc-bus-width = "8-bit";
		smc-setup-timing = <4 0 0 0>;
		smc-pulse-timing = <10 20 10 20>;
		smc-cycle-timing = <20 20>;
		nfc-timings-nfsel;
		nfc-timings-twb = <8>;
		nfc-timings-trr = <8>;
		nfc-timings-tar = <5>;
		nfc-timings-tadl = <15>;
		nfc-timings-tclr = <4>;
		status = "okay";

		nand0: nandflash {
			compatible = "microchip,nand-g1-flash";
			nand-controller = <&nfc>;
			cs-gpios = <&pioa 13 GPIO_ACTIVE_LOW>;
			status = "okay";

			/* Micron MT29F4G08ABAEA 512MB */
			nand_id0: mt29f4g08abaea {
				nand-id = [2c dc];
				nand-page-size = <4096>;
				nand-oob-size = <224>;
				nand-block-pages = <64>;
				nand-block-count = <2048>;
				nand-ecc-bits = <8>;
				nand-ecc-sector = <512>;
			};

			/* Winbond W29N01HV 128MB */
			nand_id1: w29n01hv {
				nand-id = [ef f1];
				nand-page-size = <2048>;
				nand-oob-size = <64>;
				nand-block-pages = <64>;
				nand-block-count = <1024>;
				nand-ecc-bits = <1>;
				nand-ecc-sector = <512>;
			};

			/* Macronix MX30LF4G28AD 512MB */
			nand_id2: mx30lf4g28ad {
				nand-id = [c2 dc];
				nand-page-size = <4096>;
				nand-oob-size = <256>;
				nand-block-pages = <64>;
				nand-block-count = <2048>;
				nand-ecc-bits = <8>;
				nand-ecc-sector = <512>;
			};
		};
	};
};

&flx4 {
	mchp,flexcom-mode = <SAM_FLEXCOM_MODE_SPI>;
	status = "okay";

	spi4: spi@400 {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_spi4_default>;
		cs-gpios = <&pioa 15 GPIO_ACTIVE_LOW>, <&pioa 14 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&flx6 {
	mchp,flexcom-mode = <SAM_FLEXCOM_MODE_USART>;
	status = "okay";

	uart6: serial@200 {
		current-speed = <115200>;
		pinctrl-0 = <&pinctrl_uart6_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&flx10 {
	mchp,flexcom-mode = <SAM_FLEXCOM_MODE_TWI>;
	status = "okay";

	i2c10: i2c10@600 {
		pinctrl-0 = <&pinctrl_i2c10_default>;
		pinctrl-names = "default";
		status = "okay";

		eeprom0: eeprom0@51 {
			compatible = "atmel,24mac02e4", "atmel,at24";
			reg = <0x51>;
			address-width = <8>;
			pagesize = <16>;
			size = <256>;
			timeout = <5>;
			status = "okay";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom0_eui48: eui48@fa {
					reg = <0xfa 6>;
					#nvmem-cell-cells = <0>;
				};
			};
		};
	};
};

&gmac0 {
	status = "okay";

	pinctrl-0 = <&pinctrl_gmac0_default>;
	pinctrl-names = "default";

	phy-connection-type = "rgmii";
	phy-handle = <&gmac0_phy>;

	nvmem-cells = <&eeprom0_eui48>;
	nvmem-cell-names = "mac_address";
};

&gmac0_mdio {
	status = "okay";

	pinctrl-0 = <&pinctrl_gmac0_mdio_default>;
	pinctrl-names = "default";

	gmac0_phy: ethernet-phy@7 {
		compatible = "microchip,lan8840";
		int-gpios = <&pioc 1 GPIO_ACTIVE_LOW>;
		microchip,rgmii-delay = "id";
		reg = <7>;
		status = "okay";
	};
};

&hsmc {
	status = "okay";
};

&mcan1 {
	status = "okay";
	pinctrl-0 = <&pinctrl_can1_default>;
	pinctrl-names = "default";
};

&mcan2 {
	status = "okay";
	pinctrl-0 = <&pinctrl_can2_default>;
	pinctrl-names = "default";
};

&mcan3 {
	status = "okay";
	pinctrl-0 = <&pinctrl_can3_default>;
	pinctrl-names = "default";
};

&nfc {
	status = "okay";
};

&pinctrl {
	pinctrl_can1_default: can1_default {
		group1 {
			pinmux = <PIN_PD10__CANTX1>,
				 <PIN_PD11__CANRX1>;
			bias-disable;
		};
	};

	pinctrl_can2_default: can2_default {
		group1 {
			pinmux = <PIN_PD12__CANTX2>,
				 <PIN_PD13__CANRX2>;
			bias-disable;
		};
	};

	pinctrl_can3_default: can3_default {
		group1 {
			pinmux = <PIN_PD14__CANTX3>,
				 <PIN_PD15__CANRX3>;
			bias-disable;
		};
	};

	pinctrl_gmac0_default: gmac0_default {
		group1 {
			pinmux = <PIN_PA26__G0_TX0>,
				 <PIN_PA27__G0_TX1>,
				 <PIN_PB4__G0_TX2>,
				 <PIN_PB5__G0_TX3>,
				 <PIN_PA29__G0_RX0>,
				 <PIN_PA30__G0_RX1>,
				 <PIN_PB2__G0_RX2>,
				 <PIN_PB6__G0_RX3>,
				 <PIN_PA25__G0_TXCTL>,
				 <PIN_PB3__G0_RXCK>,
				 <PIN_PA28__G0_RXCTL>;
			bias-disable;
		};

		gmac0_txck_default {
			pinmux = <PIN_PB1__G0_REFCK>;
			bias-pull-up;
		};
	};

	pinctrl_gmac0_mdio_default: gmac0_mdio_default {
		group1 {
			pinmux = <PIN_PA31__G0_MDC>,
				 <PIN_PB0__G0_MDIO>;
		};
	};

	pinctrl_i2c10_default: i2c10-default {
		group1 {
			pinmux = <PIN_PB19__FLEXCOM10_IO1>,
				 <PIN_PB20__FLEXCOM10_IO0>;
			bias-disable;
		};
	};

	pinctrl_mikrobus_an_default: pinctrl_mikrobus_an_default {
		mikrobus1_ad2 {
			pinmux = <PIN_PC5__GPIO>;
			bias-disable;
		};

		mikrobus2_ad8 {
			pinmux = <PIN_PC13__GPIO>;
			bias-disable;
		};
	};

	pinctrl_pwm_default: pinctrl_pwm_default {
		mikrobus1_pwm0 {
			pinmux = <PIN_PB15__PWML0>;
			bias-disable;
		};

		mikrobus2_pwm1 {
			pinmux = <PIN_PB17__PWML1>;
			bias-disable;
		};
	};

	pinctrl_nand_default: nand-default {
		group1 {
			pinmux = <PIN_PA0__NWER0>,
				 <PIN_PA1__A21>,
				 <PIN_PA2__A22>,
				 <PIN_PA3__D0>,
				 <PIN_PA4__D1>,
				 <PIN_PA5__D4>,
				 <PIN_PA6__D5>,
				 <PIN_PA7__D6>,
				 <PIN_PA8__D7>,
				 <PIN_PA9__D2>,
				 <PIN_PA10__D3>,
				 <PIN_PA11__NANDRDY>,
				 <PIN_PA12__NRD>,
				 <PIN_PA13__GPIO>;
			bias-disable;
		};
	};

	pinctrl_sdmmc1_default: sdmmc1-default {
		cmd-ck-data {
			pinmux = <PIN_PB22__SDMMC1_CMD>,
				 <PIN_PB23__SDMMC1_CK>,
				 <PIN_PB24__SDMMC1_DAT0>,
				 <PIN_PB25__SDMMC1_DAT1>,
				 <PIN_PB26__SDMMC1_DAT2>,
				 <PIN_PB27__SDMMC1_DAT3>;
			bias-disable;
		};

		cd-wp-rstn-vddsel {
			pinmux = <PIN_PB21__SDMMC1_RSTN>,
				 <PIN_PB28__SDMMC1_WP>,
				 <PIN_PB29__SDMMC1_CD>,
				 <PIN_PB30__SDMMC1_1V8SEL>;
			bias-disable;
		};
	};

	pinctrl_spi4_default: spi4_default {
		group1 {
			pinmux = <PIN_PA18__FLEXCOM4_IO0>,
				 <PIN_PA17__FLEXCOM4_IO1>,
				 <PIN_PA16__FLEXCOM4_IO2>;
			bias-disable;
		};

		cs_pins {
			pinmux = <PIN_PA15__GPIO>, /* GPIO CS 0 */
				 <PIN_PA14__GPIO>; /* GPIO CS 1 */
			bias-pull-up;
		};
	};

	pinctrl_uart6_default: uart6-default {
		group1 {
			pinmux = <PIN_PD18__FLEXCOM6_IO0>,
				 <PIN_PD19__FLEXCOM6_IO1>;
			bias-disable;
		};
	};

	pinctrl_usba_vbus_det: usba_vbus_det {
		pinmux = <PIN_PC8__GPIO>;
		bias-disable;
	};
};

&pit64b0 {
	clock-frequency = <DT_FREQ_M(10)>;
};

&pwm {
	clka-prescaler = <1024>;
	clka-divide-factor = <1>;
	pinctrl-0 = <&pinctrl_pwm_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pit64b1 {
	top-alarm;
	prescaler-period = <15>;
	status = "okay";
};

&pmecc {
	status = "okay";
};

&rtc {
	status = "okay";
};

&tc0_ch0 {
	status = "okay";
};

&sdmmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sdmmc1_default>;
	max-bus-freq = <DT_FREQ_M(208)>;
	no-1-8-v;
	rstn-power-en;
	auto-cmd23;
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&trng {
	status = "okay";
};

zephyr_udc0: &udphsa {
	vbus-gpios = <&pioc 8 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usba_vbus_det>;
	status = "okay";
};
